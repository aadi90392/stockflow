{
  "name": "stockflow",
  "main": "server/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stockflow-db",
      "database_id": "92690736-8753-42ec-ad6b-e22ac6bb3823",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}